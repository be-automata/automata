{
  "name": "@terragon/broadcast",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts,js --exec 'tsx src/dev.ts'",
    "deploy": "partykit deploy",
    "tsc-watch": "tsc --noEmit --watch --preserveWatchOutput",
    "tsc-check": "tsc --noEmit",
    "format": "prettier --write . --ignore-path ../../.prettierignore --config ../../.prettierrc",
    "format-check": "prettier --check . --ignore-path ../../.prettierignore --config ../../.prettierrc"
  },
  "dependencies": {
    "@e2b/code-interpreter": "^2.7.2",
    "@terragon/env": "workspace:*",
    "@terragon/types": "workspace:*",
    "@types/lodash.debounce": "^4.0.9",
    "lodash.debounce": "^4.0.8",
    "partyserver": "^0.5.10",
    "partysocket": "^1.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240718.0",
    "@types/node": "^22.15.21",
    "nodemon": "^3.1.14",
    "partykit": "^0.0.115",
    "strip-ansi": "^7.2.0",
    "tsx": "^4.23.13",
    "typescript": "^5.8.3",
    "wrangler": "^4.129.0"
  }
}
