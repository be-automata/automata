exports[`RunStatusChip (#125 C5) > every typed cause renders a chip with text (not colour alone) and a status role (AC4) > daemon-failed 1`] = `"<span role="status" title="The agent daemon failed before reaching a verdict." aria-label="Failed: The agent daemon failed before reaching a verdict."><span class="inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap bg-red-500/10 text-red-700 dark:text-red-300 border-red-500/30"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-x size-3" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6"></path><path d="m9 9 6 6"></path></svg><span>Failed</span></span></span>"`;

exports[`RunStatusChip (#125 C5) > every typed cause renders a chip with text (not colour alone) and a status role (AC4) > discarded 1`] = `"<span role="status" title="A review was already running for this PR; this newer run was dropped by policy. · org policy: finish the running review, drop newer" aria-label="Discarded: A review was already running for this PR; this newer run was dropped by policy. · org policy: finish the running review, drop newer"><span class="inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap bg-amber-500/10 text-amber-800 dark:text-amber-300 border-amber-500/30"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-slash size-3" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><line x1="9" x2="15" y1="15" y2="9"></line></svg><span>Discarded</span></span></span>"`;

exports[`RunStatusChip (#125 C5) > every typed cause renders a chip with text (not colour alone) and a status role (AC4) > plane-offline 1`] = `"<span role="status" title="The run was dispatched but never became visible on the execution plane." aria-label="Execution plane offline: The run was dispatched but never became visible on the execution plane."><span class="inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap bg-red-500/10 text-red-700 dark:text-red-300 border-red-500/30"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-cloud-off size-3" aria-hidden="true"><path d="m2 2 20 20"></path><path d="M5.782 5.782A7 7 0 0 0 9 19h8.5a4.5 4.5 0 0 0 1.307-.193"></path><path d="M21.532 16.5A4.5 4.5 0 0 0 17.5 10h-1.79A7.008 7.008 0 0 0 10 5.07"></path></svg><span>Execution plane offline</span></span></span>"`;

exports[`RunStatusChip (#125 C5) > every typed cause renders a chip with text (not colour alone) and a status role (AC4) > publish-failed 1`] = `"<span role="status" title="The verdict was produced but could not be posted to GitHub." aria-label="Publish failed: The verdict was produced but could not be posted to GitHub."><span class="inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap bg-red-500/10 text-red-700 dark:text-red-300 border-red-500/30"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-send size-3" aria-hidden="true"><path d="M14.536 21.686a.5.5 0 0 0 .937-.024l6.5-19a.496.496 0 0 0-.635-.635l-19 6.5a.5.5 0 0 0-.024.937l7.93 3.18a2 2 0 0 1 1.112 1.11z"></path><path d="m21.854 2.147-10.94 10.939"></path></svg><span>Publish failed</span></span></span>"`;

exports[`RunStatusChip (#125 C5) > every typed cause renders a chip with text (not colour alone) and a status role (AC4) > stale-skipped 1`] = `"<span role="status" title="A newer run was already queued for this PR, so this one skipped itself before starting. · org policy: finish the running review, drop newer" aria-label="Skipped (stale): A newer run was already queued for this PR, so this one skipped itself before starting. · org policy: finish the running review, drop newer"><span class="inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap bg-amber-500/10 text-amber-800 dark:text-amber-300 border-amber-500/30"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-skip-forward size-3" aria-hidden="true"><polygon points="5 4 15 12 5 20 5 4"></polygon><line x1="19" x2="19" y1="5" y2="19"></line></svg><span>Skipped (stale)</span></span></span>"`;

exports[`RunStatusChip (#125 C5) > every typed cause renders a chip with text (not colour alone) and a status role (AC4) > superseded 1`] = `"<span role="status" title="A newer commit started a new review; this run was cancelled. · org policy: finish the running review, drop newer" aria-label="Superseded: A newer commit started a new review; this run was cancelled. · org policy: finish the running review, drop newer"><span class="inline-flex items-center gap-1 rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap bg-blue-500/10 text-blue-700 dark:text-blue-300 border-blue-500/30"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-refresh-cw size-3" aria-hidden="true"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"></path><path d="M8 16H3v5"></path></svg><span>Superseded</span></span></span>"`;

