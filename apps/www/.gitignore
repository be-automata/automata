# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# opennext cloudflare adapter build output, generated in full by
# `@opennextjs/cloudflare` from /.next/ - worker.js, assets, cache and
# server-functions are all derived artifacts, never edited by hand.
/.open-next/

# wrangler local state (dev sessions, tmp bundles)
/.wrangler/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.dev.vars
.open-next
.wrangler
