{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "automata-www",
  "main": ".open-next/worker.js",
  // nodejs_compat + a recent compat date are REQUIRED by @opennextjs/cloudflare.
  "compatibility_date": "2026-06-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Bindings (added when the operator provisions resources — NOT in step 1):
  //   "r2_buckets": [{ "binding": "R2_BUCKET", "bucket_name": "..." }, ...]
  //   DATABASE_URL / secrets are set via `wrangler secret put` (see deploy/WORKERS-ENV-MAP.md)
}
