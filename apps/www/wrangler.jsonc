{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "automata-www",
  // Custom entry: passes fetch through to the OpenNext-generated .open-next/worker.js
  // and adds a scheduled() handler for the cron triggers below.
  "main": "worker-entry.ts",
  // nodejs_compat + a recent compat date are REQUIRED by @opennextjs/cloudflare.
  "compatibility_date": "2026-06-05",
  // no_handle_cross_request_promise_resolution: the neon-serverless Pool is a
  // module singleton (apps/www/src/lib/db.ts) shared across requests on workerd,
  // so its WebSocket promises can resolve in a different request context than they
  // were created in — which workerd otherwise treats as a hang and cancels the
  // request ("A promise was resolved or rejected from a different request context").
  // This flag is the runtime-sanctioned allowance for that shared-resource pattern.
  "compatibility_flags": [
    "nodejs_compat",
    "no_handle_cross_request_promise_resolution",
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  // S12: the background maintenance jobs were Vercel crons (apps/www/vercel.json)
  // which never fire on Workers. These native triggers fire the worker's scheduled()
  // handler (worker-entry.ts), which routes each cron through openNext.fetch to the
  // matching in-process route (server-lib/cron.ts runners). All four are in-process:
  // stalled-tasks (hourly) frees stuck concurrency slots, scheduled-tasks (every 1m)
  // runs due scheduled chats, queued-tasks (every 10m) drains the per-user concurrency
  // queue, automations (every 30m) runs due automations. Keep in sync with
  // CRON_TO_PATH in worker-entry.ts.
  "triggers": {
    "crons": ["0 * * * *", "*/1 * * * *", "*/10 * * * *", "*/30 * * * *"],
  },
  "observability": {
    "enabled": true,
  },
  // Native R2 bindings — packages/r2 uses these on Workers (no S3 credentials).
  // Buckets provisioned by the operator: `automata` (public) + `automata-private`.
  "r2_buckets": [
    { "binding": "R2_BUCKET", "bucket_name": "automata" },
    { "binding": "R2_PRIVATE_BUCKET", "bucket_name": "automata-private" },
  ],
  // Service binding to the broadcast (partyserver) Worker. A Worker cannot
  // reliably fetch a sibling Worker's public workers.dev URL on the same account
  // (the request 404s at the edge); the binding routes worker-to-worker directly.
  // packages/shared/broadcast-server.ts resolves env.BROADCAST via getCloudflareContext.
  "services": [{ "binding": "BROADCAST", "service": "automata-broadcast" }],
  // Other bindings/secrets set via `wrangler secret put` (see deploy/WORKERS-ENV-MAP.md)
}
