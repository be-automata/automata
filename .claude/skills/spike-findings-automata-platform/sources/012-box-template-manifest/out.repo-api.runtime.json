{
  "provider": "docker",
  "batteries": [
    {
      "id": "gstack-review",
      "requires": []
    },
    {
      "id": "somnio-skills",
      "requires": [
        "github-read-token"
      ]
    }
  ],
  "skills": [
    "github-ops"
  ],
  "mcpConfig": {
    "mcpServers": {
      "knowledge": {
        "type": "http",
        "url": "https://kb.example.internal/mcp",
        "headers": {
          "X-Scope": "org"
        }
      }
    }
  },
  "env": {
    "NODE_ENV": "test"
  },
  "secretRefs": [
    "ANTHROPIC_API_KEY",
    "ORG_STAGING_DATABASE_URL"
  ],
  "setup": "pnpm install --frozen-lockfile",
  "resources": {
    "cpu": 2,
    "memoryGb": 8,
    "diskGb": 20
  },
  "policy": {
    "egress": "allowlist",
    "allowHosts": [
      "registry.npmjs.org",
      "github.com",
      "api.anthropic.com"
    ],
    "maxRunMinutes": 45
  }
}