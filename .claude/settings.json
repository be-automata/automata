{
  "env": {
    "GSTACK_SKIP_ASIDE": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_FLOW_V3_ENABLED": "true",
    "CLAUDE_FLOW_HOOKS_ENABLED": "true"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/*.env)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p8)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/service-account*.json)",
      "Read(**/*credentials*.json)",
      "Read(**/auth.json)",
      "Read(**/.netrc)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Edit(**/*.env)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p8)",
      "Edit(**/*.jks)",
      "Edit(**/*.keystore)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/service-account*.json)",
      "Edit(**/*credentials*.json)",
      "Edit(**/auth.json)",
      "Edit(**/.netrc)",
      "Bash(hcloud server delete *)",
      "Bash(hcloud volume delete *)",
      "Bash(hcloud firewall delete *)",
      "Bash(hcloud ssh-key delete *)",
      "Bash(hcloud network delete *)",
      "Bash(hcloud load-balancer delete *)",
      "Bash(hcloud image delete *)",
      "Bash(hcloud floating-ip delete *)",
      "Bash(hcloud primary-ip delete *)",
      "Bash(hcloud placement-group delete *)",
      "Read(**/.env.secrets*)",
      "Edit(**/.env.secrets*)"
    ],
    "allow": [
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(git:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(rg:*)",
      "Bash(pwd)",
      "Bash(mv:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(echo:*)",
      "Bash(cp:*)",
      "Bash(cd:*)",
      "Bash(cat:*)",
      "Bash(which:*)",
      "Bash(ps:*)",
      "mcp__ide__getDiagnostics",
      "Bash(npx @claude-flow*)",
      "Bash(npx claude-flow*)",
      "Bash(node .claude/*)",
      "mcp__claude-flow__*",
      "WebFetch(domain:amazonaws.com)",
      "WebFetch(domain:api.anthropic.com)",
      "WebFetch(domain:api.cloudflare.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:api.neon.tech)",
      "WebFetch(domain:api.openai.com)",
      "WebFetch(domain:api.stripe.com)",
      "WebFetch(domain:api.upstash.com)",
      "WebFetch(domain:api.vercel.com)",
      "WebFetch(domain:auth.docker.io)",
      "WebFetch(domain:console.neon.tech)",
      "WebFetch(domain:firebaseio.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:googleapis.com)",
      "WebFetch(domain:index.docker.io)",
      "WebFetch(domain:js.stripe.com)",
      "WebFetch(domain:oauth2.googleapis.com)",
      "WebFetch(domain:objects.githubusercontent.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:registry-1.docker.io)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:sts.amazonaws.com)",
      "WebFetch(domain:upstash.io)",
      "WebFetch(domain:vercel.app)",
      "WebFetch(domain:workers.dev)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run lint:fix)",
      "Bash(pnpm run build)",
      "Bash(pnpm run test)",
      "Bash(pnpm run test:cov)",
      "Bash(pnpm run format:check)",
      "Bash(pnpm run openapi:check)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch)",
      "Bash(git show *)"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "gh *",
      "gcloud *",
      "aws *",
      "az *",
      "flyctl *",
      "vercel *",
      "wrangler *",
      "kubectl *",
      "terraform *",
      "docker *",
      "open *",
      "osascript *",
      "somnio-broker-aws *",
      "somnio-broker-gcloud *",
      "somnio-broker-gh *",
      "somnio-broker-vercel *",
      "somnio-broker-wrangler *",
      "somnio-broker-az *",
      "somnio-broker-flyctl *",
      "somnio-broker-kubectl *",
      "somnio-broker-terraform *"
    ],
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "api.github.com",
        "amazonaws.com",
        "api.anthropic.com",
        "api.cloudflare.com",
        "api.neon.tech",
        "api.openai.com",
        "api.stripe.com",
        "api.upstash.com",
        "api.vercel.com",
        "auth.docker.io",
        "console.neon.tech",
        "firebaseio.com",
        "googleapis.com",
        "index.docker.io",
        "js.stripe.com",
        "oauth2.googleapis.com",
        "objects.githubusercontent.com",
        "raw.githubusercontent.com",
        "registry-1.docker.io",
        "sts.amazonaws.com",
        "upstash.io",
        "vercel.app",
        "workers.dev"
      ]
    }
  },
  "enableAllProjectMcpServers": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}/.claude/hooks/inject-rules.py\" 2>/dev/null || true"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-$PWD}/.claude/hooks/deny-destructive-cloud.py\""
          }
        ]
      }
    ]
  }
}
