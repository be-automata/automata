# The dedicated rootless Docker daemon for agent-run containers (ADR-013
# Decision 2). A SYSTEMD USER UNIT of `automata-runner`, installed by
# install-rootless-docker.sh into ~automata-runner/.config/systemd/user/.
#
# Separate from the rootful daemon that runs the engine stack: its own data
# root, its own socket, no host root. Root inside a run container is
# `automata-runner` on the host; every other container uid is a subordinate
# id with no host identity.
#
# The socket is /run/automata-docker/docker.sock (dir 0750
# automata-runner:automata-docker, tmpfiles.d), group `automata-docker`: the
# worker reaches it through that group, without sudo. The worker sets
# WORKER_CONTAINER_DOCKER_SOCKET to it only on a box running the dev-only
# container path (WORKER_DEV_CONTAINER_RUNS=1).
#
# Resource limits (--memory, --pids-limit, --cpus) need the user manager's
# cgroup delegation (user@<uid>.service.d/10-automata-delegate.conf); Delegate=
# below hands this unit's own subtree to dockerd.

[Unit]
Description=Rootless Docker daemon for automata agent-run containers (ADR-013)
Documentation=https://github.com/be-automata/automata/blob/main/docs/adr/ADR-013-image-per-run-execution.md

[Service]
Type=notify
NotifyAccess=all
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# slirp4netns, not the default: the daemon itself needs egress only to pull by
# digest; run containers are --network none and never touch it.
Environment=DOCKERD_ROOTLESS_ROOTLESSKIT_NET=slirp4netns
ExecStart=/usr/bin/dockerd-rootless.sh --data-root=%h/docker --host=unix:///run/automata-docker/docker.sock --group=automata-docker --exec-opt=native.cgroupdriver=systemd --log-driver=none --live-restore=false
ExecReload=/bin/kill -s HUP $MAINPID
TimeoutSec=0
RestartSec=2
Restart=always
StartLimitBurst=3
StartLimitInterval=60s
LimitNOFILE=infinity
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes
KillMode=mixed

[Install]
WantedBy=default.target
