# Automata execution-plane worker — the Linux box's single systemd unit (#192).
#
# This is a TEMPLATE. Replace the __PLACEHOLDER__ tokens, install to
# /etc/systemd/system/automata-worker.service, then `systemctl daemon-reload`.
# It replaces the macOS launchd unit (../com.automata.worker.plist) one-for-one:
# ONE unit, no standby, `slots: 1` plus the kernel box lock keep the box to one
# agent run at a time.
#
# Tokens:
#   __USER__   service account the worker runs as (NOT root, NOT the agent uid)
#   __HOME__   that account's home — holds .automata/{run-worker.sh,worker-box.env}
#   __REPO__   absolute path to the automata-platform checkout

[Unit]
Description=Automata execution-plane worker
Documentation=file://__REPO__/packages/worker/deploy/README.md
# The worker dials the engine over loopback, and the engine is a compose stack.
# Ordering only — Requires= would take the worker down with a compose restart,
# and the SDK reconnects on its own.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=exec
User=__USER__
Group=__USER__
WorkingDirectory=__REPO__/packages/worker

# ── Wait for the engine before the auth gate can mean anything ─────────────
#
# `After=docker.service` orders against the DAEMON, not against the compose
# stack's readiness, so on a cold boot the worker wins the race. The launcher's
# first act is the fail-closed auth gate, which probes the engine — and a probe
# against a socket that is not listening yet returns curl's `000`, which the gate
# correctly refuses. Observed on the first reboot drill (2026-09-28):
#
#   [assert-auth-enabled] FAIL: negative probe returned unexpected status 000000
#
# The unit self-healed via Restart=always, so it costs no availability. It costs
# something worse: every reboot stamps a line that reads exactly like an auth
# failure, so anyone alerting on `assert-auth-enabled.*FAIL` gets a false positive
# per boot and learns to ignore the one line that stands between this box and a
# `-dev` engine with a publicly known signing key.
#
# So wait for readiness here, where "not up yet" is a known state, instead of
# making the security gate guess. Bounded, not infinite: a genuinely dead engine
# must keep failing visibly on the 15s Restart cycle, never hang the unit in
# `activating`.
ExecStartPre=/bin/bash -c 'for _ in $(seq 1 30); do curl -fsS -o /dev/null --max-time 2 http://127.0.0.1:8888/api/ready && exit 0; sleep 2; done; echo "engine not ready on 127.0.0.1:8888 after 60s" >&2; exit 1'

ExecStart=/bin/bash __HOME__/.automata/run-worker.sh

# ── Drain, not kill ────────────────────────────────────────────────────────
#
# The SDK's SIGTERM handler pauses assignment on the engine and then AWAITS the
# in-flight run to completion. Everything here exists to let that finish.
#
# KillMode=mixed: SIGTERM goes to MainPID alone, so the worker decides when its
# children die. `control-group` would SIGTERM the agent and its daemon directly
# and drop the in-flight review — the exact loss this unit is shaped to prevent.
KillMode=mixed
KillSignal=SIGTERM
# A real agent run is minutes, and a review can sit behind one. This is the
# budget before systemd escalates to SIGKILL; too small silently reintroduces
# the mid-run drop under a different name. It is deliberately above the 30-minute
# scheduleTimeout other variants wait on (definition.ts).
TimeoutStopSec=2100
SendSIGKILL=yes

# Relaunch on graceful exit and on crash, rate-limited the same 15s the launchd
# unit used via ThrottleInterval.
Restart=always
RestartSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=automata-worker

# ── #204: the per-run memory ceiling needs a delegated cgroup subtree ──────
#
# Delegation hands the worker write access to its OWN cgroup subtree, which is
# what lets it create and cap a per-run cgroup with NO privilege. The alternative
# #193 specified — `systemd-run --scope --uid=<agent>` — cannot work here: as this
# unit's User= the scope is refused by polkit ("Interactive authentication
# required"), and making it possible would need either a sudoers entry for
# `systemd-run` (arbitrary root: sudoers(5) permits any arguments for a bare
# command path, and `--uid=0` is one) or a polkit rule amounting to "start any
# transient unit as any uid".
#
# NARROW, not `Delegate=yes`. Only the two controllers the ceiling uses. Widening
# it hands the worker every other controller for no gain.
#
# The worker moves itself into a `supervisor/` leaf at boot before enabling the
# controllers, because cgroup v2 refuses to enable them for the children of a
# cgroup that still holds processes. Without that the enable fails EBUSY.
#
# Removing this line does not break the boot — the worker logs that the ceiling
# is OFF and runs uncapped, which is the state before #204. That is deliberate
# (the feature is opt-in) and is also why the log line says so loudly.
Delegate=memory pids

# ── Hardening that does NOT fight the agent-uid design ─────────────────────
#
# The worker legitimately spawns an agent under a DIFFERENT uid via sudo, so
# NoNewPrivileges MUST stay off — it would break the uid drop that the whole
# egress fence depends on. The rest is free.
NoNewPrivileges=no
PrivateTmp=no

# ProtectSystem=full remounts /usr read-only inside this unit's namespace — and
# /usr/local/automata is a subpath of /usr. The launcher stages the daemon bundle
# there on every agent-uid run (run-worker.sh.template), so without this
# exception that install fails with "Read-only file system" the moment
# WORKER_AGENT_USER is set — i.e. exactly when the Linux fence is turned on, and
# never before, which is why it stayed invisible while the mode was off.
# Verified on the box: the same write under a transient unit with
# ProtectSystem=full fails read-only and succeeds without it.
#
# Keep the exception as narrow as the one directory. Widening it to /usr/local
# hands the unit everything else installed there.
ProtectSystem=full
ReadWritePaths=/usr/local/automata

ProtectHome=no
ProtectKernelTunables=yes

# ProtectControlGroups is deliberately NOT set, and this is the one hardening
# line that cannot coexist with the ceiling above. `=yes` remounts
# /sys/fs/cgroup READ-ONLY inside this unit's namespace, so the delegated subtree
# stays correctly owned (automata:automata) and entirely unwritable — the worker
# then logs "ceiling OFF" citing a missing Delegate= that is in fact present,
# which is a maximally confusing symptom for a one-line cause.
#
# Isolated on the box rather than assumed, because removing more hardening than
# necessary would be the wrong trade. With Delegate=memory pids:
#   baseline (no hardening) ............ subtree_control WRITABLE
#   ProtectControlGroups=yes ........... read-only   <-- the culprit
#   ProtectKernelTunables=yes .......... WRITABLE
#   ProtectSystem=full ................. WRITABLE
#   the other two together ............. WRITABLE
# So exactly one line goes; the other two stay.
RestrictSUIDSGID=no

[Install]
WantedBy=multi-user.target
