# Automata execution-plane worker — the Linux box's single systemd unit (#192).
#
# This is a TEMPLATE. Replace the __PLACEHOLDER__ tokens, install to
# /etc/systemd/system/automata-worker.service, then `systemctl daemon-reload`.
# It replaces the macOS launchd unit (../com.automata.worker.plist) one-for-one:
# ONE unit, no standby, `slots: 1` plus the kernel box lock keep the box to one
# agent run at a time.
#
# Tokens:
#   __USER__   service account the worker runs as (NOT root, NOT the agent uid)
#   __HOME__   that account's home — holds .automata/{run-worker.sh,worker-box.env}
#   __REPO__   absolute path to the automata-platform checkout

[Unit]
Description=Automata execution-plane worker
Documentation=file://__REPO__/packages/worker/deploy/README.md
# The worker dials the engine over loopback, and the engine is a compose stack.
# Ordering only — Requires= would take the worker down with a compose restart,
# and the SDK reconnects on its own.
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=exec
User=__USER__
Group=__USER__
WorkingDirectory=__REPO__/packages/worker

# ── Wait for the engine before the auth gate can mean anything ─────────────
#
# `After=docker.service` orders against the DAEMON, not against the compose
# stack's readiness, so on a cold boot the worker wins the race. The launcher's
# first act is the fail-closed auth gate, which probes the engine — and a probe
# against a socket that is not listening yet returns curl's `000`, which the gate
# correctly refuses. Observed on the first reboot drill (2026-09-28):
#
#   [assert-auth-enabled] FAIL: negative probe returned unexpected status 000000
#
# The unit self-healed via Restart=always, so it costs no availability. It costs
# something worse: every reboot stamps a line that reads exactly like an auth
# failure, so anyone alerting on `assert-auth-enabled.*FAIL` gets a false positive
# per boot and learns to ignore the one line that stands between this box and a
# `-dev` engine with a publicly known signing key.
#
# So wait for readiness here, where "not up yet" is a known state, instead of
# making the security gate guess. Bounded, not infinite: a genuinely dead engine
# must keep failing visibly on the 15s Restart cycle, never hang the unit in
# `activating`.
ExecStartPre=/bin/bash -c 'for _ in $(seq 1 30); do curl -fsS -o /dev/null --max-time 2 http://127.0.0.1:8888/api/ready && exit 0; sleep 2; done; echo "engine not ready on 127.0.0.1:8888 after 60s" >&2; exit 1'

# ── #367: (re)load the agent-uid loopback fence, bound to THIS start's cgroup ──
#
# `inet automata_loopback` admits the agent's loopback connections by the
# RECEIVING socket's cgroup (`socket cgroupv2 … "system.slice/automata-worker.service"`),
# and nft resolves that path to a cgroup inode id AT LOAD TIME. systemd creates
# this unit's cgroup before any ExecStartPre= runs and recreates it on every
# restart, so the table is loaded here, by the unit itself, on every start:
# loaded earlier (automata-egress.service, Before= this unit) the path does not
# exist yet; loaded once, the id goes stale on the first restart and the fence
# then refuses the run's own proxy and broker — every run dies in seconds.
#
# ExecStartPre=, NOT ExecStartPost=: Type=exec means an ExecStartPost= would
# run after the worker process is up and polling, an unfenced window. The `+`
# runs the loader as root with the unit's sandboxing (ProtectKernelTunables,
# ProtectSystem, ProtectControlGroups) lifted for this one command — it needs
# CAP_NET_ADMIN and the real /sys/fs/cgroup. A non-zero exit stops the unit
# before ExecStart= (fail-closed), and the 15s Restart= cycle keeps the reason
# in the journal. The engine-readiness wait above is unaffected.
#
# Install: render __AGENT_UID__/__MARK__ into /etc/automata/loopback-nft.conf
# and the loader to /usr/local/sbin/nft-loopback-load.sh (AGENT-UID-PROVISIONING.md §7).
ExecStartPre=+/usr/bin/env WORKER_USER=__USER__ /usr/local/sbin/nft-loopback-load.sh /etc/automata/loopback-nft.conf

ExecStart=/bin/bash __HOME__/.automata/run-worker.sh

# ── Drain BEFORE the signal (#386) ─────────────────────────────────────────
#
# Every stop — `systemctl stop`/`restart`, a reboot — first pauses this worker
# in the engine and waits until it holds no run (scripts/drain-for-restart.ts),
# and only then does systemd send KillSignal. The SDK's own SIGTERM drain stops
# the engine heartbeat first, so a drain past the heartbeat window gets the run
# REASSIGNED: on one box the run-terminal ledger catches it, on two the other
# box would run it while this one still is. Pausing first means the SIGTERM
# meets an idle worker.
#
# Best-effort by design: `--for-stop` always exits 0 (a failed ExecStop= must
# not wedge a stop or a shutdown), and on its deadline it leaves the worker
# paused and lets the SIGTERM drain take over, with the ledger behind it. The
# deadline (1800 s) stays under TimeoutStopSec, which systemd applies to this
# command and again to the SIGTERM phase. Skipped when the worker already
# exited on its own ($MAINPID empty): there is nothing to drain.
# automata-worker-safe-restart is still the way to restart on purpose: it
# refuses to restart a worker that is still busy, where this cannot refuse.
ExecStop=/bin/bash -c '[ -n "$MAINPID" ] || exit 0; set -a; . __HOME__/.automata/worker-box.env; set +a; exec node --import tsx scripts/drain-for-restart.ts --for-stop --timeout-s 1800'

# ── Drain, not kill ────────────────────────────────────────────────────────
#
# The SDK's SIGTERM handler pauses assignment on the engine and then AWAITS the
# in-flight run to completion. Everything here exists to let that finish.
#
# KillMode=mixed: SIGTERM goes to MainPID alone, so the worker decides when its
# children die. `control-group` would SIGTERM the agent and its daemon directly
# and drop the in-flight review — the exact loss this unit is shaped to prevent.
KillMode=mixed
KillSignal=SIGTERM
# A real agent run is minutes, and a review can sit behind one. This is the
# budget before systemd escalates to SIGKILL; too small silently reintroduces
# the mid-run drop under a different name. It is deliberately above the 30-minute
# scheduleTimeout other variants wait on (definition.ts).
TimeoutStopSec=2100
SendSIGKILL=yes

# Relaunch on graceful exit and on crash, rate-limited the same 15s the launchd
# unit used via ThrottleInterval.
Restart=always
RestartSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=automata-worker

# ── #204: the per-run memory ceiling is an OPT-IN DROP-IN, not part of this unit ──
#
# The ceiling needs two things this unit deliberately does NOT provide:
# `Delegate=memory pids` and the absence of `ProtectControlGroups=`. Both live in
# `automata-worker.service.d/10-ceiling.conf`, installed only on a box that
# enables the ceiling.
#
# WHY IT IS SPLIT. `ProtectControlGroups=yes` remounts /sys/fs/cgroup read-only
# inside the unit's namespace, so a delegated subtree is correctly OWNED and
# completely unwritable and the ceiling cannot be armed. Shipping it relaxed in
# the base unit would weaken hardening on every box, including the ones that
# never enable the ceiling — a regression they get nothing for. The drop-in
# confines the relaxation to the boxes that need it.
#
# A MISCONFIGURED BOX FAILS LOUDLY, it does not run uncapped: with
# `WORKER_RUN_MEMORY_MAX` set and the drop-in absent, the worker refuses to boot
# and names the missing delegation (`hello/worker.ts`). With the ceiling unset,
# this unit boots exactly as it did before #204.
#
# Install:  install -D -m0644 automata-worker.service.d/10-ceiling.conf \
#             /etc/systemd/system/automata-worker.service.d/10-ceiling.conf
#           systemctl daemon-reload && systemctl restart automata-worker.service

# ── Hardening that does NOT fight the agent-uid design ─────────────────────
#
# The worker legitimately spawns an agent under a DIFFERENT uid via sudo, so
# NoNewPrivileges MUST stay off — it would break the uid drop that the whole
# egress fence depends on. The rest is free.
NoNewPrivileges=no
PrivateTmp=no

# ProtectSystem=full remounts /usr read-only inside this unit's namespace — and
# /usr/local/automata is a subpath of /usr. The launcher stages the daemon bundle
# there on every agent-uid run (run-worker.sh.template), so without this
# exception that install fails with "Read-only file system" the moment
# WORKER_AGENT_USER is set — i.e. exactly when the Linux fence is turned on, and
# never before, which is why it stayed invisible while the mode was off.
# Verified on the box: the same write under a transient unit with
# ProtectSystem=full fails read-only and succeeds without it.
#
# Keep the exception as narrow as the one directory. Widening it to /usr/local
# hands the unit everything else installed there.
ProtectSystem=full
ReadWritePaths=/usr/local/automata

ProtectHome=no
ProtectKernelTunables=yes

# ProtectControlGroups IS set here, and the ceiling's drop-in is what turns it
# off where the ceiling is enabled. `=yes` remounts /sys/fs/cgroup READ-ONLY
# inside this unit's namespace, so a delegated subtree stays correctly owned and
# entirely unwritable — the worker then reports a missing `Delegate=` that is in
# fact present, a maximally confusing symptom for a one-line cause.
#
# Isolated on the box rather than assumed, because relaxing more hardening than
# necessary would be the wrong trade. With Delegate=memory pids:
#   baseline (no hardening) ............ subtree_control WRITABLE
#   ProtectControlGroups=yes ........... read-only   <-- the only culprit
#   ProtectKernelTunables=yes .......... WRITABLE
#   ProtectSystem=full ................. WRITABLE
#   the other two together ............. WRITABLE
# So the drop-in relaxes exactly this one line, and only on boxes that cap runs.
ProtectControlGroups=yes

RestrictSUIDSGID=no

[Install]
WantedBy=multi-user.target
