[Unit]
Description=Maple local: run-telemetry store and triage UI (loopback only, internal use)
After=network-online.target

[Service]
ExecStart=/usr/local/lib/automata-telemetry/maple/maple start --host 127.0.0.1 --port 4318 --offline --data-dir /var/lib/automata-maple/data --on-dirty-store restore-checkpoint
Restart=on-failure
RestartSec=5
# A static system user (install-run-telemetry.sh creates it), NOT DynamicUser: DynamicUser turns
# the StateDirectory into a symlink to /var/lib/private/..., which Maple refuses as a data dir.
User=automata-telemetry
Group=automata-telemetry
StateDirectory=automata-maple
StateDirectoryMode=0700
# ProtectHome leaves no writable HOME; Maple keeps its own state under the state dir.
Environment=HOME=/var/lib/automata-maple
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
CapabilityBoundingSet=
# Embedded ClickHouse (chDB): throttle at 1G, kill only past 2G.
MemoryHigh=1G
MemoryMax=2G

[Install]
WantedBy=multi-user.target
