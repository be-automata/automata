  "dropped": [
    {
      "name": "semgrep",
      "reason": "A hash-pinned install needs a lockfile for a ~60-package PyPI closure, its useful rules come from the semgrep.dev registry (network plus metrics), and the offline semgrep-rules set is under the restrictive Semgrep Rules License v1.0."
    },
    {
      "name": "gstack-cso",
      "reason": "gstack cso v3 routes every read through a 62 MB bun-compiled launcher that is gitignored upstream, and its preamble can fall back to executing a PR-supplied script from the checkout."
    },
    {
      "name": "gsd-integration-checker",
      "reason": "It audits .planning/ phase summaries rather than a pull request diff, so it has no role in the review lane."
    }
