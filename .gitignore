# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next
dist
out

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

data/
output.txt

# claude code
apps/www/.claude-flow
# Shared config (.claude/settings.json, agents/, commands/) is committed on
# purpose; only personal overrides are ignored.
.claude/settings.local.json

# ruflo / claude-flow per-checkout runtime state: daemon pid, logs, metrics and
# generated config. Self-bootstraps on first command and is written at whatever
# depth the tool runs from (see ruvnet/ruflo#695), so these stay unanchored.
.claude-flow/
.swarm/
.hive-mind/
claude-flow.config.json
claude-flow.db
hive-mind-prompt-*.txt
.claude/checkpoints/
.claude/helpers/
.claude/proven-config.json
.claude/.proven-config-version
.claude/security-scans/

# gstack local artifacts: browse captures, network logs and security reports.
# Treated as sensitive, not just noise - these must never leave the machine.
.gstack/

# turborepo
.turbo

# vscode-extension local workspace settings
apps/vscode-extension/.vscode/
.gstack/

# hatchet-lite IT harness (packages/worker/src/agent-run/hatchet-it-harness.ts) — written per run, removed in afterAll
packages/worker/.hatchet-it-override.generated.yml

# Agent scratch + local vector store. `.claude/tmp/` holds raw tool transcripts
# written during a session; a `git add -A` swept 2.6MB of them (and ruvector.db)
# into a PR once. Neither is referenced by any build, test or deploy step.
.claude/tmp/
ruvector.db

# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
