# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next
dist
out

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

data/
output.txt

# claude code
apps/www/.claude-flow
.claude/settings.local.json

# ruflo / claude-flow per-checkout runtime state (daemon pid, logs, metrics)
# and generated config. Regenerated on demand; never shared between worktrees.
.claude-flow/
.swarm/
.claude/proven-config.json
.claude/.proven-config-version
.claude/security-scans/

# turborepo
.turbo

# vscode-extension local workspace settings
apps/vscode-extension/.vscode/
.gstack/
