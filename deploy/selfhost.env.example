# =============================================================================
# Self-host env example — SaaS-free first boot of apps/www.
#
# Copy to a real env file and load it into the process (envsafe validates it):
#   cp deploy/selfhost.env.example deploy/selfhost.env
#   set -a; . deploy/selfhost.env; set +a   # then run next / drizzle-kit
#
# Every value below is a throwaway/dummy safe to commit. Rotate the secrets and
# swap the R2/GitHub/AI credentials for real ones before exposing this to anyone.
#
# Ports assume the conventional defaults. If they collide with another local
# stack, override the SELFHOST_*_PORT vars for docker-compose.selfhost.yml AND
# update the matching URLs below (DATABASE_URL, REDIS_URL, R2_ENDPOINT, R2_PUBLIC_URL).
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
# `next start` runs as production; `next dev` runs as development (envsafe
# devDefaults only apply in development — this file sets every var explicitly so
# it boots either way).
NODE_ENV=production

# ---- Core datastores (docker-compose.selfhost.yml) --------------------------
# Postgres 16 — drizzle-kit push targets this.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Redis via the Upstash-compatible HTTP shim. Leaving REDIS_URL empty is also
# supported — the app falls open to an in-memory single-node stand-in
# (apps/www/src/lib/redis.ts). Point at the shim to exercise real Redis.
REDIS_URL=http://localhost:8079
REDIS_TOKEN=redis_dev_token

# ---- Auth / crypto (OURS — required) ----------------------------------------
# Generate fresh: openssl rand -hex 32
BETTER_AUTH_SECRET=4cae7802d1f10d1529ef37d4da2aa9e2f7b1cab575aa5912d4c021cbd0794d54
BETTER_AUTH_URL=http://localhost:3000
# www <-> broadcast service auth. openssl rand -hex 32
INTERNAL_SHARED_SECRET=073b5f94de9deb627e480b657fb196cc3af997ac3d33163bb59597b27eca15dd
# Bearer auth on the cron endpoints (driver moves to Hatchet). openssl rand -hex 32
CRON_SECRET=771752433ed4b68f8f36a06dcfd9b95b211c2e1bc1f5220f33937b541a6fd711
# AES master key for user credentials at rest — MUST be exactly 32 bytes.
ENCRYPTION_MASTER_KEY=selfhost-dev-master-key-32bytes!

# ---- Public URLs (read directly via process.env; required under next start) --
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BROADCAST_URL=http://localhost:1999
NEXT_PUBLIC_BROADCAST_HOST=localhost:1999
# Optional — falls back to https://docs.terragonlabs.com if unset.
NEXT_PUBLIC_DOCS_URL=http://localhost:3001

# ---- AI providers (OURS — gate real model calls, not boot) ------------------
# Dummy but well-formed. Replace to actually run agents.
ANTHROPIC_API_KEY=sk-ant-selfhost-dummy-key-replace-me
OPENAI_API_KEY=sk-selfhost-dummy-key-replace-me
# Optional providers — empty = off.
OPENROUTER_API_KEY=
GOOGLE_AI_STUDIO_API_KEY=

# ---- Object storage: MinIO stands in for Cloudflare R2 (OURS — required) ----
# R2_ENDPOINT makes the @aws-sdk/client-s3 client talk to MinIO instead of R2.
# When set, R2_ACCOUNT_ID is unused for endpoint derivation (kept for validation).
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_ACCOUNT_ID=selfhost
R2_ENDPOINT=http://localhost:9000
R2_BUCKET_NAME=terragon
R2_PRIVATE_BUCKET_NAME=terragon-private
# Public bucket is created anonymously-readable by the compose init job.
R2_PUBLIC_URL=http://localhost:9000/terragon

# ---- GitHub App (OURS — required; gates GitHub OAuth + webhook intake) -------
# Dummy but well-formed. Replace with a real GitHub App's values to wire intake.
GITHUB_CLIENT_ID=Iv1.0000000000000000
GITHUB_CLIENT_SECRET=e8ac32ab51563c74a9db200bb219f24e2cb12d94
GITHUB_APP_ID=123456
GITHUB_WEBHOOK_SECRET=6562b1c881d5515598ba9ae06639f79ff32381d90a4adf0930499f201b653e77
NEXT_PUBLIC_GITHUB_APP_NAME=automata-selfhost
# PEM in single-line escaped-newline form (Option 1 in apps/www/.env.example).
# Throwaway 2048-bit RSA key — parseable but not tied to any GitHub App.
GITHUB_APP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQCwDQjyPAQuuUYO\neFExyLBZWHaKTlnXywiz6daemz9rw30rycAm/egDAjGT1WJfuiKcaDLsjjuEuAcb\nicJ12etAvntW2WuVUWol/CrfbtmJTcrqngRGS14Y1SczmyAgj7nqp/iXkUGoEdgn\nbP6T2njPuj5pDLLsRwJ1TeDYAcytX3u1RN3CvdzTQ4ysz+KrSR3yZZCEnh4y5WvN\nqymdcKA3G4dKbu3KAhrLfVt3WA9c5I/Rm1eauCQuHztwAARgyJmskS++KUFwaiNb\njSyEqzL37DHjVBlLR/SbjKPG6sCCE9qc+5yzuypuaAvb4Gt/8gO3ngqjgR36uWtX\n9UKcJtfBAgMBAAECggEATnawyw2Wq6BlqeNUBMU2W8vCoWfEQRo7mbwZrHzy6jup\nmQ+FNZuqgVTD9eh/vLx/2ofSUn4d5swCVvKyGcZzRFrhK9chTN6JWb6m+Qg1qi1i\nx+h/bTkACj9OBoEX84s7SGtur1bNFXRGi2PXntwbRjHyyO0g/Y+0d8Wq9Xrv10Dc\n0xGrCLj1oNzxJa8Q/A9Cp2qra+WqpezWxWbB/9A0iY3UFICzegVY/H6MZihpoU9R\nSg3OdI4R2JfaeyQ/x/EFCjoCtlM61n7cqHxC3/xfRrG54obfXAGRGxLpNeR0YEgP\nKBFjn9Vv4O4UCjEll2pLwUeEvs1ulxXnalTvHwcX5QKBgQD2WjV/3kKJ/NPAy+S8\nT3TuRtJW6jDSIYFRJ8tKvWD29nRElf+zfscyosqkD587prphkckeo0dGWqAjvx/i\nxLeJfthY0dJez5vr4FeUhZ1CX1jGLA0x5Qxf+hgP3bOqGmsuUvCIihzGE1fk9LrE\nznXMKBajMF4GfFpzvdcd5igI3wKBgQC28gXbQWA6zGM+43wSjM1jNTVwN9gNQcQw\n7MziI61JREdUErBh8lELtXeyn1M7TzoiqxIRHs5aY5qNAvKrMR28mVKIcZFgqbZ7\nN+zzd+nl8ldPLT+K9Aqu0mnNxoLRi5AaPN/UO6EKmJb3cPLNRzM3d80duHrI/rQ9\nmfT5Er0TXwKBgQDMfwGeDV/qr4cPqbFMaCDGkt+T6n9wTwPL3F6ywhW1q8vEC0fh\nNkIg1GWmXpltqO9aguwSlLNbwWrhgYv0cBty9WqeAD7DGU9zNB0/WtK5/+/vQS4K\n1vm4yiAjO4Qilh+Wqp6kmRFdkz0I/+Xx7Ph36mcwO7wxYhSrs1DYru9YvQKBgHeq\nT9JfLQbI8pIMUvf/Scl+4HmKzbO+NQqbmljBZXPrSYzgvKcUzZaPGMCqHtNIu4o5\nxBOWxvuw80MRjpIUCpN25tmBD8reuBJZPpDy+vgCUMHlow7NGr/HupVzJ9bRJ21C\nLFayumAn93fbVbaYwBOkNXMfXJFkqZkxv1+8thiZAoGAUPGCTvHSTMr3psUgqDK3\nhJGW7RggVe9ggi1nWUAK2vfWiALEE33Y9ctPiQvKRZ7oX9NxcGlcRaInuWevuvgK\n3aiDs47yL9/d/Z/yEsc2KKXJ+QYBqRDYvNpmxB4/t6ewLivccLdM9SiWbOSQgytU\n7EfNsS9//K6Oc2qUBxuWxzs=\n-----END PRIVATE KEY-----"

# ---- Anthropic status side-service (UNKNOWN — treated as deferred) -----------
# Points at an undocumented side service; harmless dummies for self-host.
IS_ANTHROPIC_DOWN_URL=http://localhost:5173
IS_ANTHROPIC_DOWN_API_SECRET=0b363c9afff4ba0cc7dca2b75b54f1fb

# ---- Sandbox provider (OURS — config) ---------------------------------------
# Self-host uses the local Docker provider, so E2B/Daytona stay off.
SANDBOX_PROVIDER=docker

# ---- Per-user resource caps (neutral self-host defaults) --------------------
MAX_CONCURRENT_TASKS_PER_USER=3
MAX_AUTOMATIONS_PER_USER=20

# =============================================================================
# DEFERRED SaaS — all OFF for a SaaS-free boot. Leave empty; the app degrades
# gracefully (analytics no-op, billing takes the neutral default, email/Slack
# disabled). Fill any of these in only to re-enable that specific integration.
# =============================================================================

# Remote sandboxes (using local Docker instead)
E2B_API_KEY=
DAYTONA_API_KEY=

# Product analytics (PostHog)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Billing (Stripe) — empty = billing disabled, lifecycle never blocks on credits
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CORE_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_CREDIT_PACK=

# Transactional + marketing email
RESEND_API_KEY=
LOOPS_API_KEY=

# Slack app
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_FEEDBACK_WEBHOOK_URL=

# Dev tunnels (not needed when sandboxes run locally via Docker)
NGROK_DOMAIN=
LOCALHOST_PUBLIC_DOMAIN=
